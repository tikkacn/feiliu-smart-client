{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.tikkacn.feiliu-smart-client",
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./Microsoft.WebView2.FixedVersionRuntime.133.0.3065.92.x64/"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English", "Russian"],
        "installMode": "perMachine",
        "template": "./packages/windows/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": false,
      "endpoints": [
        "https://github.com/tikkacn/feiliu-smart-client/releases/download/updater/update-fixed-webview2.json"
      ],
      "pubkey": "REPLACE_WITH_FEILIU_UPDATER_PUBLIC_KEY"
    }
  }
}
